# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:XXXXX@ep-soft-firefly-abubokzg-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://qualipilot.vercel.app

# ─── Auth ───────────────────────────────────────────────────────────────────
# Génère avec : openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_32_CHARS_MIN

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX
STRIPE_PRICE_STARTER_MONTHLY=price_XXXXX
STRIPE_PRICE_STARTER_YEARLY=price_XXXXX
STRIPE_PRICE_PRO_MONTHLY=price_XXXXX
STRIPE_PRICE_PRO_YEARLY=price_XXXXX
STRIPE_PRICE_CABINET_MONTHLY=price_XXXXX
STRIPE_PRICE_CABINET_YEARLY=price_XXXXX

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXX
EMAIL_FROM=QualiPilot <no-reply@qualipilot.fr>

# ─── Email (SMTP — alternatif à Resend) ─────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASSWORD=XXXXX

# ─── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXX
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ─── Cron ───────────────────────────────────────────────────────────────────
# Secret pour sécuriser /api/reminders/run (générer avec openssl rand -hex 16)
REMINDER_CRON_SECRET=CHANGE_ME

# ─── Stockage fichiers (optionnel — défaut: .storage/) ──────────────────────
# LOCAL_FILE_STORAGE_DIR=/tmp/qualipilot-files
# MAX_EVIDENCE_UPLOAD_BYTES=20971520

# ─── Mentions légales ───────────────────────────────────────────────────────
LEGAL_COMPANY_NAME=Votre Société SAS
LEGAL_COMPANY_FORM=SAS
LEGAL_COMPANY_CAPITAL=1000
LEGAL_COMPANY_SIREN=000000000
LEGAL_COMPANY_SIRET=00000000000000
LEGAL_COMPANY_ADDRESS=12 rue Exemple, 75001 Paris
LEGAL_PUBLISHER_NAME=Prénom Nom
LEGAL_HOST_NAME=Vercel Inc.
LEGAL_HOST_ADDRESS=340 Pine Street, Suite 801, San Francisco, CA 94104, USA
LEGAL_CONTACT_EMAIL=contact@qualipilot.fr
LEGAL_DPO_EMAIL=dpo@qualipilot.fr
